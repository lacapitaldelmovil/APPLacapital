# Configuración de Square API
SQUARE_ACCESS_TOKEN=tu_token_square_aqui

# Configuración de MongoDB (para sync_worker.py)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=nombre_de_tu_base_de_datos
COLLECTION_NAME=productos
LOCATION_ID=tu_location_id_square

# Notas:
# - Copia este archivo a .env y completa los valores reales
# - El archivo .env está en .gitignore para no subir credenciales
# - SQUARE_ACCESS_TOKEN: Obtén tu token desde Square Dashboard
# - MONGO_URI: Tu URI de conexión a MongoDB
